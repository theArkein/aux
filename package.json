{
  "name": "aux",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/aux"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev --workspace=packages/server",
    "start:server": "npm run dev --workspace=packages/server",
    "start:client": "tsx packages/aux/bin/auxd.ts & tsx packages/aux/bin/aux.ts; pkill -f auxd",
    "stop": "pkill -f auxd; pkill -f 'packages/server'; pkill -f mpv; echo stopped"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@arkein/aux": "^0.1.0"
  }
}
